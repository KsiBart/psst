# Postgres connection string (Neon via Vercel Marketplace works out of the box)
DATABASE_URL=postgres://user:password@host:5432/psst

# 32 random bytes, base64 — encrypts who-drew-whom in the database.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it stable: if it changes, existing draws can't be read and the organizer must reset them.
ASSIGNMENT_KEY=

# Resend (password reset + organizer welcome emails). Use ./scripts/set-resend-key.sh to set it.
RESEND_API_KEY=
# Without your own domain Resend only delivers from onboarding@resend.dev to your own account address.
EMAIL_FROM=Psst! <onboarding@resend.dev>

# Optional: public base URL for links in emails/QR. On Vercel it defaults to the production *.vercel.app URL.
APP_URL=
